{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Classeur URSSAF",
  "identifier": "io.github.serwen195.classeur-urssaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Classeur URSSAF",
        "width": 1120,
        "height": 800,
        "minWidth": 860,
        "minHeight": 620,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Business",
    "shortDescription": "Classeur chiffré pour les déclarations URSSAF",
    "longDescription": "Range et retrouve vos déclarations mensuelles de chiffre d'affaires. Données chiffrées sur votre poste, synchronisées via un dépôt Git privé.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3ODI2RDU2QTVFQkQ1NjAKUldSZzFldWxWbTJDMXpSNkl2NU5KaU1lZm12QndkRVhZNC9mRVFnd2tuVUVpTW9LMmljaStuOEMK",
      "endpoints": [
        "https://github.com/Serwen195/classeur-ursaff/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
